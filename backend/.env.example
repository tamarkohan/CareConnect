# Copy to backend/.env and fill in. Never commit the real .env.

GEMINI_API_KEY=

# Supabase → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose or change it, stored contracts can no longer be decrypted.
CONTRACT_ENCRYPTION_KEY=

# Optional
# CONTRACT_TTL_DAYS=90
# GEMINI_EMBED_MODEL=gemini-embedding-001
# SESSION_TTL_DAYS=180

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Demo account: phone number "123" signs in without a code. Reset it before a
# demo with `npm run demo:reset`.
DEMO_LOGIN=true

# Test mode: this code works for EVERY phone number and email. Where a real code can
# be sent (e.g. email via Gmail below), it is sent too and either one works.
# Handy for trying the app with many test accounts. Remove before real users.
# OTP_TEST_CODE=123456

# One-time codes. Without a provider, codes are printed in this terminal
# (only when NODE_ENV is not "production"), which is enough for local testing.
# SMS (Twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Email (Resend, free tier, needs your own domain):
# RESEND_API_KEY=
# OTP_EMAIL_FROM=CareConnect <login@your-domain>
# Email from a Gmail account (free, no domain; steps in USERS_SETUP.md):
# GMAIL_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GMAIL_SCRIPT_SECRET=the-same-long-random-text-as-in-the-script
