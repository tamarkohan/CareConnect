# Copy to backend/.env and fill in. Never commit the real .env.

GEMINI_API_KEY=

# Supabase → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose or change it, stored contracts can no longer be decrypted.
CONTRACT_ENCRYPTION_KEY=

# Optional
# CONTRACT_TTL_DAYS=90
# GEMINI_EMBED_MODEL=gemini-embedding-001
# SESSION_TTL_DAYS=180

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Demo account: phone number "123" signs in without a code. Reset it before a
# demo with `npm run demo:reset`.
DEMO_LOGIN=true

# One-time codes. Without a provider, codes are printed in this terminal
# (only when NODE_ENV is not "production"), which is enough for local testing.
# SMS (Twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Email (Resend, free tier):
# RESEND_API_KEY=
# OTP_EMAIL_FROM=CareConnect <login@your-domain>
